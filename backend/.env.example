MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/skillswap?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
PORT=5000

# Email Configuration
# Option 1: SendGrid (Recommended for production - works on Render)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_USER=noreply@yourdomain.com

# Option 2: Gmail (For development only - may not work on Render)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Frontend URL
FRONTEND_URL=https://your-frontend-url.com
